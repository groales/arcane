# Arcane: copia este archivo a .env y personaliza los valores.
# Genera ENCRYPTION_KEY con: openssl rand -hex 32
ARCANE_IMAGE=ghcr.io/getarcaneapp/manager:latest
ARCANE_PORT=3552
APP_URL=http://localhost:3552
ENCRYPTION_KEY=

# UID/GID del usuario propietario de archivos que Arcane cree en proyectos.
# En macOS Docker Desktop puede mapearlos mediante la VM; cambia si hace falta.
PUID=1000
PGID=1000

# Directorio local administrado por Arcane; ruta relativa a este proyecto.
PROJECTS_HOST_PATH=./projects
